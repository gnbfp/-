# 复制成 .env 后填写。.env 已被 .gitignore 忽略，永远不要提交。
# 注意：必须是 NAME=VALUE 形式；没有变量名的裸值会被 src/config.py 直接拒绝。

# —— 飞书自建应用（docs/ARCHITECTURE.md §12.1）——
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# —— DeepSeek（OpenAI 兼容接口）——
# LLM_BASE_URL 请从控制台/文档确认完整地址后再填
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# —— 落盘目录（唯一落盘位置，D-30；默认仓库根 data/）——
DATA_DIR=data

# —— M8 评测：5 份真实作业书所在的目录（D-41：原文不入库）——
# eval/docs.json 里只写文件名，真实目录放这里 —— 公开仓库里不写死任何人的本机路径。
# 例：EVAL_DOCS_DIR=C:\Users\<你>\Desktop\作业书
EVAL_DOCS_DIR=
